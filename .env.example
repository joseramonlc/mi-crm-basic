# Convex — estas dos variables las escribe automáticamente `npx convex dev`
# en .env.local la primera vez que lo ejecutas (requiere iniciar sesión con
# tu cuenta de Convex). No hace falta rellenarlas a mano en desarrollo.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# En producción (Railway), NEXT_PUBLIC_CONVEX_URL debe apuntar al deployment
# de producción de Convex (npx convex deploy), no al de desarrollo.

# Clerk — claves de la instancia (Dashboard de Clerk → API keys). La secret key
# nunca se expone al navegador: sin prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Rutas propias de auth: el CRM usa sus pantallas (JOS-64), no las prefabricadas
# de Clerk. Estos valores son fijos, no secretos.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/registro
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/actividad
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/actividad

# Además, el deployment de Convex necesita CLERK_JWT_ISSUER_DOMAIN (lo lee
# convex/auth.config.ts). No va en este fichero: se fija con
# `npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<slug>.clerk.accounts.dev`.
