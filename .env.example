# Convex — estas dos variables las escribe automáticamente `npx convex dev`
# en .env.local la primera vez que lo ejecutas (requiere iniciar sesión con
# tu cuenta de Convex). No hace falta rellenarlas a mano en desarrollo.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# En producción (Railway), NEXT_PUBLIC_CONVEX_URL debe apuntar al deployment
# de producción de Convex (npx convex deploy), no al de desarrollo.
